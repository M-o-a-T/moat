#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure override_dh_auto_build override_dh_auto_test override_dh_auto_clean:

override_dh_install:
	mkdir -p debian/moat-node-red/usr/share/moat/node-red
	cp -a src/js/moat-meta-codec/lib debian/moat-node-red/usr/share/moat/node-red/lib
	cp -a src/js/moat-meta-codec/moat-meta-codec.html \
	   src/js/moat-meta-codec/package.json \
	   debian/moat-node-red/usr/share/moat/node-red/
