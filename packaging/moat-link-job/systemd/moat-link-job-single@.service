[Unit]
Description=MoaT-Link single-node job runner for %i
After=moat-link-server.service

ConditionFileNotEmpty=/etc/moat/moat.yaml

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
ExecStart=/usr/lib/moat/link/job/run-single %i

User=MoaT-Link
Group=MoaT

EnvironmentFile=/usr/lib/moat/link/env
EnvironmentFile=-/etc/moat/link.env

TimeoutSec=300
WatchdogSec=10
Restart=always
RestartSec=10
