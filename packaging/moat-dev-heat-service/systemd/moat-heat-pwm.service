[Unit]
Description=MoaT heating: software PWM for GPIO outputs
After=moat-link-server.service
After=flashmq.service
After=time-sync.target
Wants=time-sync.target

ConditionFileNotEmpty=/etc/moat/moat.yaml

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/moat dev heat pwm

EnvironmentFile=-/etc/moat/heat.env

Restart=always
RestartSec=10
