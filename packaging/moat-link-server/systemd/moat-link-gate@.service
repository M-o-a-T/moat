[Unit]
Description=MoaT-Link gateway
After=moat-link.service
After=time-sync.target
Wants=time-sync.target

ConditionFileNotEmpty=/etc/moat/moat.yaml

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
ExecStart=/usr/bin/moat link gate %I run

EnvironmentFile=/usr/lib/moat/link/env
EnvironmentFile=-/etc/moat/link.env

TimeoutSec=300
WatchdogSec=10

Restart=always
RestartSec=30
