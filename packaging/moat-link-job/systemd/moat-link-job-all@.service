[Unit]
Description=MoaT-Link all-nodes job runner for %i
After=moat-link-server.service
After=time-sync.target
Wants=time-sync.target

ConditionFileNotEmpty=/etc/moat/moat.yaml

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
ExecStart=/usr/lib/moat/link/job/run-all %i

User=MoaT-Link
Group=MoaT

EnvironmentFile=/usr/lib/moat/link/env
EnvironmentFile=-/etc/moat/link.env

TimeoutSec=300
WatchdogSec=10
Restart=always
RestartSec=10
