#!/usr/bin/env python3
"""
Pre-commit hook to run tests on TS/JS packages with modified files.

Mirrors the pytest-modified hook: takes the list of modified files from
pre-commit, filters for files under ts/ (or js/), determines which package
directory they belong to, and runs that package's own test command.

Each package owns its test runner: the top-level ``Makefile``'s ``jstest``
target likewise delegates to ``$(MAKE) test`` per package. Hard-coding a
single runner (e.g. vitest) breaks packages whose ``package.json`` ``test``
script uses Node's built-in runner (``node --test``).

If no TS/JS files are modified, exits 0 (nothing to test).
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# Prefer the project's pinned virtualenv so child processes (notably the
# Python interop server spawned by vitest) run against the same interpreter
# and installed dependencies as the rest of the repo, not pre-commit's
# isolated hook environment. Fall back to a PATH lookup when no venv exists.
_VENV_PYTHON = Path(".venv/bin/python3")


def _resolve_python() -> str | None:
    """Return a ``python3`` that can ``import moat``, or ``None``.

    Order: project venv, then candidates on PATH. Skips interpreters that
    can't import moat (e.g. pre-commit's bare hook env).
    """
    candidates: list[str] = []
    if _VENV_PYTHON.is_file() and os.access(_VENV_PYTHON, os.X_OK):
        candidates.append(str(_VENV_PYTHON))
    if shutil.which("python3"):
        candidates.append("python3")
    # System interpreter as a last resort; pre-commit shadows PATH with its
    # own env, so /usr/bin/python3 is reached explicitly.
    candidates.append("/usr/bin/python3")

    seen: set[str] = set()
    for cand in candidates:
        if cand in seen:
            continue
        seen.add(cand)
        try:
            r = subprocess.run(  # noqa: S603
                [cand, "-c", "import moat.lib.rpc"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
                check=False,
            )
        except (OSError, subprocess.SubprocessError):
            continue
        if r.returncode == 0:
            return cand
    return None


def _python_env() -> dict[str, str]:
    """Env for the test subprocess, with a moat-capable python3 on PATH.

    Interop suites spawn ``python3``; ensure that resolves to an
    interpreter that can import moat (preferring the project venv). Falls
    back to the inherited environment unchanged if no such interpreter is
    found — the interop suite will then surface the import failure itself.
    """
    env = os.environ.copy()
    py = _resolve_python()
    if py is None:
        return env
    py_dir = str(Path(py).resolve().parent)
    path = env.get("PATH", "")
    env["PATH"] = py_dir + (":" + path if path else "")
    return env


def get_package_dir(filepath: str) -> Path | None:
    """
    Given a file path, return the TS/JS package directory it belongs to.

    For ts/moat-lib-rpc/src/codec.ts → ts/moat-lib-rpc/
    For ts/moat-lib-rpc/test/unit/wire.test.ts → ts/moat-lib-rpc/

    Returns None if the file is not under ts/ or js/.
    """
    path = Path(filepath)
    parts = path.parts

    # Only consider files under ts/ or js/
    if not parts or parts[0] not in ("ts", "js"):
        return None

    # The package directory is the second-level directory
    # e.g. ts/moat-lib-rpc/ or js/moat-meta-codec/
    if len(parts) < 2:
        return None

    pkg_dir = Path(parts[0]) / parts[1]
    if pkg_dir.is_dir() and (pkg_dir / "package.json").exists():
        return pkg_dir

    return None


def _has_interop_config(pkg_dir: Path) -> bool:
    """Whether the package ships a vitest interop config."""
    return (pkg_dir / "vitest.interop.config.ts").exists()


def _has_test_script(pkg_dir: Path) -> bool:
    """Whether the package declares a runnable ``test`` script."""
    manifest = pkg_dir / "package.json"
    try:
        data = json.loads(manifest.read_text())
    except (OSError, ValueError):
        return False
    scripts = data.get("scripts") or {}
    return isinstance(scripts, dict) and bool(scripts.get("test"))


def main(filenames: list[str]) -> int:
    """
    Main entry point for pre-commit hook.

    Args:
        filenames: List of modified files from pre-commit.

    Returns:
        0 if all tests pass, non-zero otherwise.
    """
    # Check whether to skip
    if os.environ.get("NO_TEST", "") in {"1", "Y", "y"}:
        return 0

    # Collect unique package directories
    pkg_dirs: set[Path] = set()

    for filename in filenames:
        if (pkg_dir := get_package_dir(filename)) is not None:
            pkg_dirs.add(pkg_dir)

    # If no TS/JS packages found, nothing to test
    if not pkg_dirs:
        return 0

    failed_pkgs: list[Path] = []
    env = _python_env()

    for pkg_dir in sorted(pkg_dirs):
        print(f"\n{'=' * 60}")
        if (pkg_dir / "node_modules").is_dir():
            print(f"Testing {pkg_dir}")
        else:
            print(f"Installing deps in {pkg_dir}")
        print("=" * 60)

        # Install dependencies if missing, matching `make jstest`.
        if not (pkg_dir / "node_modules").is_dir():
            inst = subprocess.run(
                ["npm", "ci"],  # noqa: S607
                cwd=str(pkg_dir),
                check=False,
                env=env,
            )
            if inst.returncode != 0:
                failed_pkgs.append(pkg_dir)
                continue

        # Delegate to the package's own test runner via its declared
        # ``test`` script — vitest for some packages, ``node --test`` for
        # others. Mirrors the top-level Makefile's ``jstest`` target.
        if not _has_test_script(pkg_dir):
            print(f"No 'test' script in {pkg_dir}/package.json; skipping.")
            continue

        result = subprocess.run(
            ["npm", "test"],  # noqa: S607
            cwd=str(pkg_dir),
            check=False,
            env=env,
        )

        if result.returncode != 0:
            failed_pkgs.append(pkg_dir)
            continue

        # Also run the interop suite if this package has one.
        if _has_interop_config(pkg_dir):
            result = subprocess.run(
                ["npx", "vitest", "run", "--config", "vitest.interop.config.ts"],  # noqa: S607
                cwd=str(pkg_dir),
                check=False,
                env=env,
            )
            if result.returncode != 0:
                failed_pkgs.append(pkg_dir)

    if failed_pkgs:
        print(f"\n{'=' * 60}")
        print("FAILED test packages:")
        for d in failed_pkgs:
            print(f"  - {d}")
        print("=" * 60)
        return 1

    print(f"\n{'=' * 60}")
    print("All TS/JS tests passed!")
    print("=" * 60)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
