[Unit]
Description=MoaT heating: restart the Solvis Modbus poller when it gets stuck
After=moat-link-server.service
After=flashmq.service
After=time-sync.target
Wants=time-sync.target

ConditionFileNotEmpty=/etc/moat/moat.yaml

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/moat dev heat modbus_mon

User=MoaT-Heat
Group=MoaT

EnvironmentFile=-/etc/moat/heat.env

Restart=always
RestartSec=30
