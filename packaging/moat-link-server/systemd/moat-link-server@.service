[Unit]
Description=MoaT-Link main server, cfg %i

ConditionFileNotEmpty=/etc/moat/moat-%i.yaml

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
ExecStart=/usr/lib/moat/link/run
SuccessExitStatus=42

RuntimeDirectory=moat/link

KillSignal=TERM
FinalKillSignal=INT
WatchdogSignal=KILL
TimeoutStopSec=5

User=MoaT-Link
Group=MoaT

EnvironmentFile=/usr/lib/moat/link/env
EnvironmentFile=-/usr/lib/moat/link-%i/env
EnvironmentFile=-/etc/moat/link.env
EnvironmentFile=-/etc/moat/link-%i.env
Environment=MOAT-cfg=/etc/moat/moat-%i.yaml

TimeoutSec=300
WatchdogSec=10
