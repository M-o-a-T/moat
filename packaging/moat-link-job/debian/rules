#!/usr/bin/make -f

export PYBUILD_NAME=moat-link-job
%:
	dh $@ --with python3 --buildsystem=pybuild

execute_after_dh_install:
	$(MAKE) installsystemd PREFIX=debian/moat-link-job

# Only the default runner is enabled; the others are started by hand.
override_dh_installsystemd:
	dh_installsystemd moat-link-job.service
